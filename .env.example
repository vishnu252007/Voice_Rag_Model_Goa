# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Sarvam (speech-to-text) — get from sarvam.ai dashboard
SARVAM_API_KEY=your_sarvam_key_here

# LLM for answer generation — pick ONE and set LLM_PROVIDER to match
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: Gemini (set LLM_PROVIDER=gemini and fill this instead)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Vector DB — "cloud" needs QDRANT_URL + QDRANT_API_KEY below.
# "local" runs Qdrant embedded on disk (no network call, faster for dev) but
# will NOT persist on most hosting platforms with ephemeral storage — use
# "cloud" for your deployed/live link.
QDRANT_MODE=cloud
QDRANT_LOCAL_PATH=./qdrant_local_data
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here
QDRANT_COLLECTION=hh_goa_rag

# Local embedding model — no key needed, downloads automatically
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Optional: set to "true" to print retrieval stage timings during dev.
# Leave unset/false for the eval loop and final submission.
DEBUG_TIMING=false

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave unset to allow all origins (fine for a hackathon demo, tighten if
# you have a specific known frontend domain).
CORS_ORIGINS=
