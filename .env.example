# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Speech-to-Text (Sarvam AI) — get from sarvam.ai dashboard
SARVAM_API_KEY=your_sarvam_key_here

# Generation Mode:
# "fast" = in-process ultra-fast synthesis (<1ms generation, guaranteed <200ms end-to-end latency)
# "llm"  = neural LLM generation via Groq Qwen
GENERATION_MODE=fast

# LLM Configuration (used when GENERATION_MODE=llm)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Vector Search Backend ("faiss" in-process or "qdrant" cloud)
VECTOR_BACKEND=faiss
FAISS_INDEX_PATH=./faiss_index.bin
FAISS_METADATA_PATH=./faiss_metadata.pkl

# Multilingual Embedding Model (downloads automatically from Hugging Face)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Guardrail & Retrieval Settings
MIN_RETRIEVAL_SCORE=0.08
TOP_K_RETRIEVE=12
TOP_K_FINAL=6

# Query LRU Cache
CACHE_ENABLED=true
CACHE_MAX_SIZE=500

# Optional: comma-separated list of allowed frontend origins for CORS.
# Leave unset / empty to allow all origins.
CORS_ORIGINS=
